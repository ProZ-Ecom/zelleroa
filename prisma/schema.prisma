  agent                          User?                    @relation("OrderAgent", fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_agent")
  commissions                    commissions[]
  users_orders_created_byTousers User?                    @relation("orders_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_orders_created_by")
  users_orders_updated_byTousers User?                    @relation("orders_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_orders_updated_by")
  payments                       Payment[]
  refunds                        refunds[]
  return_requests                return_requests[]
  replacement_requests           replacement_requests[]
  shipments                      shipments[]
  inventory_reservations         inventory_reservations[]

  @@index([delivered_at], map: "idx_order_delivered_at")
  @@index([cancelled_at], map: "idx_order_cancelled_at")
  @@index([cart_id], map: "fk_order_cart")
  @@index([couponId], map: "fk_order_coupon")
  @@index([delivery_slot_id], map: "fk_order_slot")
  @@index([created_by], map: "fk_orders_created_by")
  @@index([updated_by], map: "fk_orders_updated_by")
  @@index([agent_id], map: "fk_orders_agent")
  @@index([referral_code], map: "idx_orders_referral_code")
  @@index([createdAt], map: "idx_order_created")
  @@index([order_status], map: "idx_order_status")
  @@index([userId], map: "idx_order_user")
  @@map("orders")
}

