/// The customer-facing style/design under a Product (e.g. Product "T-Shirt" ->
/// Styles "V Neck T-Shirt", "Solo T-Shirt"). Owns the descriptive/style-level
/// fields and the Style-level image gallery. A Style groups one or more
/// admin-only Items (e.g. "Regular Fit", "Slim Fit", "Oversized"); Color and
/// Size splits live two levels down on ProductVariant/VariantUnitPrice.
model Style {
  id                             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                           String            @default("UUID()") @db.VarChar(255)
  productId                      BigInt            @map("product_id") @db.UnsignedBigInt
  /// Required by the admin API for every new Item; nullable only so rows
  /// created before brands moved to this level stay valid.
  brandId                        BigInt?           @map("brand_id") @db.UnsignedBigInt
  name                           String            @db.VarChar(200)
  slug                           String            @unique(map: "idx_item_slug") @db.VarChar(220)
  sku                            String?           @unique(map: "idx_item_sku") @db.VarChar(100)
  short_description              String?           @db.VarChar(500)
  description                    String?           @db.Text
  ingredients                    String?           @db.Text
  is_ready_to_mix                Boolean           @default(false) @map("is_ready_to_mix")
  cooking_recipe                 String?           @map("cooking_recipe") @db.Text
  shelf_life                     String?           @map("shelf_life") @db.VarChar(100)
  veg_type                       products_veg_type @default(na)
  base_price                     Decimal           @default(0.00) @db.Decimal(10, 2)
  is_featured                    Boolean           @default(false)
  is_default                     Boolean           @default(false)
  isActive                       Boolean           @default(true) @map("is_active")
  out_of_stock                   Boolean           @default(false) @map("out_of_stock")
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deleted_at                     DateTime?         @db.Timestamp(0)
  created_by                     BigInt?           @db.UnsignedBigInt
  updated_by                     BigInt?           @db.UnsignedBigInt
  product                        Product           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_product")
  brand                          ProductBrand?     @relation(fields: [brandId], references: [id], onUpdate: NoAction, map: "fk_styles_brand")
  users_styles_created_byTousers User?             @relation("styles_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_items_created_by")
  users_styles_updated_byTousers User?             @relation("styles_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_items_updated_by")
  images                         StyleImage[]
  items                          Item[]
  cartItems                      CartItem[]
  orderItems                     OrderItem[]
  wishlistItems                  WishlistItem[]

  @@index([productId], map: "idx_item_product")
  @@index([brandId], map: "idx_styles_brand")
  @@index([created_by], map: "fk_items_created_by")
  @@index([updated_by], map: "fk_items_updated_by")
  @@map("styles")
}

/// Style-level images shown on the storefront Style card/gallery.
model StyleImage {
  id                                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                 String?  @db.VarChar(255)
  styleId                              BigInt   @map("item_id") @db.UnsignedBigInt
  image_url                            String   @db.VarChar(500)
  alt_text                             String?  @db.VarChar(150)
  sort_order                           Int      @default(0)
  is_primary                           Boolean  @default(false) @map("is_primary")
  created_at                           DateTime @default(now()) @db.Timestamp(0)
  updated_at                           DateTime @default(now()) @db.Timestamp(0)
  is_active                            Boolean  @default(true)
  created_by                           BigInt?  @db.UnsignedBigInt
  updated_by                           BigInt?  @db.UnsignedBigInt
  style                                Style    @relation(fields: [styleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_itemimg_item")
  users_style_images_created_byTousers User?    @relation("style_images_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_item_images_created_by")
  users_style_images_updated_byTousers User?    @relation("style_images_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_item_images_updated_by")

  @@index([styleId], map: "idx_itemimg_item")
  @@index([created_by], map: "fk_item_images_created_by")
  @@index([updated_by], map: "fk_item_images_updated_by")
  @@map("style_images")
}

/// The admin-only sub-variant under a Style (e.g. Style "V Neck T-Shirt" ->
/// Items "Regular Fit", "Slim Fit", "Oversized"). Never shown directly to
/// customers; Color (ProductVariant) and Size (VariantUnitPrice) splits live
/// one/two levels down. Reuses the "items" table name freed up by the Style
/// rename above.
model Item {
  id                            BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                          String                  @default("UUID()") @db.VarChar(255)
  styleId                       BigInt                  @map("style_id") @db.UnsignedBigInt
  name                          String                  @db.VarChar(200)
  slug                          String                  @unique(map: "idx_new_item_slug") @db.VarChar(220)
  sku                           String?                 @unique(map: "idx_new_item_sku") @db.VarChar(100)
  short_description             String?                 @db.VarChar(500)
  description                   String?                 @db.Text
  base_price                    Decimal                 @default(0.00) @db.Decimal(10, 2)
  is_featured                   Boolean                 @default(false)
  is_default                    Boolean                 @default(false)
  isActive                      Boolean                 @default(true) @map("is_active")
  out_of_stock                  Boolean                 @default(false) @map("out_of_stock")
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deleted_at                    DateTime?               @db.Timestamp(0)
  created_by                    BigInt?                 @db.UnsignedBigInt
  updated_by                    BigInt?                 @db.UnsignedBigInt
  style                         Style                   @relation(fields: [styleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_newitem_style")
  users_items_created_byTousers User?                   @relation("items_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_newitem_created_by")
  users_items_updated_byTousers User?                   @relation("items_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_newitem_updated_by")
  variants                      ProductVariant[]
  cartItems                     CartItem[]
  orderItems                    OrderItem[]
  wishlistItems                 WishlistItem[]
  item_attribute_values         item_attribute_values[]

  @@index([styleId], map: "idx_newitem_style")
  @@index([created_by], map: "fk_newitem_created_by")
  @@index([updated_by], map: "fk_newitem_updated_by")
  @@map("items")
}

model ProductVariant {
  id                                       BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                     String                      @default("UUID()") @db.VarChar(255)
  itemId                                   BigInt                      @map("item_id") @db.UnsignedBigInt
  variant_name                             String                      @default("") @map("variant_name") @db.VarChar(100)
  slug                                     String?                     @unique(map: "idx_variant_slug") @db.VarChar(255)
  color_name                               String?                     @map("color_name") @db.VarChar(50)
  color_hex                                String?                     @map("color_hex") @db.VarChar(7)
  price_adjustment                         Decimal                     @default(0.00) @map("price_adjustment") @db.Decimal(10, 2)
  is_featured                              Boolean                     @default(false)
  is_default                               Boolean                     @default(false)
  isActive                                 Boolean                     @default(true) @map("is_active")
  out_of_stock                             Boolean                     @default(false) @map("out_of_stock")
  createdAt                                DateTime                    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                                DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deleted_at                               DateTime?                   @db.Timestamp(0)
  created_by                               BigInt?                     @db.UnsignedBigInt
  updated_by                               BigInt?                     @db.UnsignedBigInt
  product_variant_images                   product_variant_images[]
  users_product_variants_created_byTousers User?                       @relation("product_variants_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_product_variants_created_by")
  users_product_variants_updated_byTousers User?                       @relation("product_variants_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_product_variants_updated_by")
  item                                     Item                        @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_variant_item")
  variant_unit_prices                      VariantUnitPrice[]
  cart_items                               CartItem[]
  wishlist_items                           WishlistItem[]
  order_items                              OrderItem[]
  replacement_request_items                replacement_request_items[]
  variant_attribute_values                 variant_attribute_values[]

  @@index([created_by], map: "fk_product_variants_created_by")
  @@index([updated_by], map: "fk_product_variants_updated_by")
  @@index([itemId], map: "idx_variant_item")
  @@index([isActive, deleted_at, createdAt], map: "idx_variant_active_listing")
  @@index([out_of_stock], map: "idx_variant_out_of_stock")
  @@map("product_variants")
}

model VariantUnitPrice {
  id                                          BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                        String                      @default("UUID()") @db.VarChar(255)
  variant_id                                  BigInt                      @map("variant_id") @db.UnsignedBigInt
  unit_id                                     BigInt                      @map("unit_id") @db.UnsignedBigInt
  unit_value                                  Decimal                     @default(0.00) @db.Decimal(10, 2)
  attribute_value_id                          BigInt?                     @db.UnsignedBigInt
  sku                                         String                      @unique(map: "sku") @db.VarChar(100)
  base_price                                  Decimal                     @default(0.00) @db.Decimal(10, 2)
