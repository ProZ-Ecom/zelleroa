  uuid                           String?                  @default("UUID()") @db.VarChar(255)
  orderNumber                    String                   @unique(map: "order_number") @map("order_number") @db.VarChar(50)
  userId                         BigInt                   @map("user_id") @db.UnsignedBigInt
  cart_id                        BigInt?                  @db.UnsignedBigInt
  couponId                       BigInt?                  @map("coupon_id") @db.UnsignedBigInt
  delivery_slot_id               BigInt?                  @db.UnsignedBigInt
  order_status                   orders_order_status      @default(pending)
  payment_status                 orders_payment_status    @default(pending)
  subtotal                       Decimal                  @default(0.00) @db.Decimal(10, 2)
  discountAmount                 Decimal                  @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount                      Decimal                  @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  shipping_charge                Decimal                  @default(0.00) @db.Decimal(10, 2)
  totalAmount                    Decimal                  @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  notes                          String?                  @db.VarChar(500)
  placed_at                      DateTime?                @db.Timestamp(0)
  createdAt                      DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
