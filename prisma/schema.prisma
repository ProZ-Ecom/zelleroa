  address         String?           @db.VarChar(500)
  notes           String?           @db.VarChar(500)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime          @default(now()) @updatedAt @db.Timestamp(0)
  deleted_at      DateTime?         @db.Timestamp(0)
  created_by      BigInt?           @db.UnsignedBigInt
  updated_by      BigInt?           @db.UnsignedBigInt
  purchase_orders purchase_orders[]

  @@index([name], map: "idx_vendors_name")
}

model purchase_orders {
  id            BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String                   @unique(map: "uq_po_uuid") @db.VarChar(64)
  po_number     String                   @unique(map: "uq_po_number") @db.VarChar(30)
  vendor_id     BigInt                   @db.UnsignedBigInt
  status        purchase_orders_status   @default(DRAFT)
  expected_date DateTime?                @db.Date
  notes         String?                  @db.VarChar(500)
  reject_reason String?                  @db.VarChar(255)
  total_amount  Decimal                  @default(0.00) @db.Decimal(12, 2)
  submitted_at  DateTime?                @db.Timestamp(0)
  approved_by   BigInt?                  @db.UnsignedBigInt
  approved_at   DateTime?                @db.Timestamp(0)
  ordered_at    DateTime?                @db.Timestamp(0)
  received_at   DateTime?                @db.Timestamp(0)
  cancelled_at  DateTime?                @db.Timestamp(0)
  created_at    DateTime                 @default(now()) @db.Timestamp(0)
  updated_at    DateTime                 @default(now()) @updatedAt @db.Timestamp(0)
  created_by    BigInt?                  @db.UnsignedBigInt
  updated_by    BigInt?                  @db.UnsignedBigInt
  vendor        vendors                  @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_po_vendor")
  items         purchase_order_items[]
  receipts      purchase_receipts[]
  history       purchase_order_history[]

  @@index([vendor_id], map: "idx_po_vendor")
  @@index([status], map: "idx_po_status")
}

model purchase_order_items {
  id                    BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_order_id     BigInt                   @db.UnsignedBigInt
  variant_unit_price_id BigInt                   @db.UnsignedBigInt
  quantity_ordered      Int
  quantity_received     Int                      @default(0)
  unit_cost             Decimal                  @default(0.00) @db.Decimal(10, 2)
  created_at            DateTime                 @default(now()) @db.Timestamp(0)
  purchase_order        purchase_orders          @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_poi_po")
  variant_unit_price    VariantUnitPrice         @relation(fields: [variant_unit_price_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_poi_vup")
  receipt_items         purchase_receipt_items[]

  @@index([purchase_order_id], map: "idx_poi_po")
  @@index([variant_unit_price_id], map: "idx_poi_vup")
}

model purchase_receipts {
  id                BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_order_id BigInt                   @db.UnsignedBigInt
  receipt_number    String                   @unique(map: "uq_receipt_number") @db.VarChar(30)
  received_at       DateTime                 @default(now()) @db.Timestamp(0)
  notes             String?                  @db.VarChar(500)
  received_by       BigInt?                  @db.UnsignedBigInt
  created_at        DateTime                 @default(now()) @db.Timestamp(0)
  purchase_order    purchase_orders          @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_receipt_po")
  items             purchase_receipt_items[]

  @@index([purchase_order_id], map: "idx_receipt_po")
}

model purchase_receipt_items {
  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  receipt_id             BigInt               @db.UnsignedBigInt
  purchase_order_item_id BigInt               @db.UnsignedBigInt
  variant_unit_price_id  BigInt               @db.UnsignedBigInt
  quantity_received      Int
  unit_cost              Decimal              @default(0.00) @db.Decimal(10, 2)
  receipt                purchase_receipts    @relation(fields: [receipt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ri_receipt")
  order_item             purchase_order_items @relation(fields: [purchase_order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ri_poi")
  variant_unit_price     VariantUnitPrice     @relation(fields: [variant_unit_price_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ri_vup")

  @@index([receipt_id], map: "idx_ri_receipt")
  @@index([purchase_order_item_id], map: "idx_ri_poi")
  @@index([variant_unit_price_id], map: "idx_ri_vup")
}

model purchase_order_history {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  purchase_order_id BigInt          @db.UnsignedBigInt
  from_status       String?         @db.VarChar(30)
  to_status         String          @db.VarChar(30)
  note              String?         @db.VarChar(255)
  changed_by        BigInt?         @db.UnsignedBigInt
  created_at        DateTime        @default(now()) @db.Timestamp(0)
  purchase_order    purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_poh_po")

  @@index([purchase_order_id], map: "idx_poh_po")
}

enum purchase_orders_status {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}
