  @@index([cartId], map: "fk_cartitem_cart")
  @@index([productId], map: "fk_cartitem_product")
  @@index([styleId], map: "fk_cartitem_item")
  @@index([itemId], map: "fk_cartitem_newitem")
  @@index([variantId], map: "fk_cartitem_variant")
  @@index([variantUnitPriceId], map: "fk_cartitem_variant_unit_price")
