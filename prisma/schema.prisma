  users_cart_items_created_byTousers User?             @relation("cart_items_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_cart_items_created_by")
  users_cart_items_updated_byTousers User?             @relation("cart_items_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_cart_items_updated_by")
