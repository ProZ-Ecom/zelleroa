  created_by                                  BigInt?                     @db.UnsignedBigInt
  updated_by                                  BigInt?                     @db.UnsignedBigInt
  variant                                     ProductVariant              @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vup_variant")
  product_units                               product_units               @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vup_unit")
  attribute_value                             AttributeValue?             @relation(fields: [attribute_value_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_vup_size_value")
  inventories                                 Inventory?
  inventory_transactions                      InventoryTransaction[]
  variant_price_history                       variant_price_history[]
  users_variant_unit_prices_created_byTousers User?                       @relation("variant_unit_prices_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_vup_created_by")
  users_variant_unit_prices_updated_byTousers User?                       @relation("variant_unit_prices_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_vup_updated_by")
  cartItems                                   CartItem[]
  orderItems                                  OrderItem[]
  replacement_request_items                   replacement_request_items[]
  wishlist_items                              WishlistItem[]
  reviews                                     Review[]
  combo_product_items                         combo_product_items[]
  stock_adjustments                           stock_adjustments[]
  stock_reports                               stock_reports[]
  offer_items                                 offer_items[]
  inventory_reservations                      inventory_reservations[]
  purchase_order_items                        purchase_order_items[]
  purchase_receipt_items                      purchase_receipt_items[]

  @@unique([variant_id, attribute_value_id], map: "uniq_vup_variant_size")
  @@index([variant_id], map: "fk_vup_variant")
  @@index([unit_id], map: "fk_vup_unit")
  @@index([attribute_value_id], map: "fk_vup_size_value")
  @@index([created_by], map: "fk_vup_created_by")
  @@index([updated_by], map: "fk_vup_updated_by")
  @@map("variant_unit_prices")
}

model ProductImage {
