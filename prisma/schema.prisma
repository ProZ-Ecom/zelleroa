  image_url                              String   @db.VarChar(500)
  altText                                String?  @map("alt_text") @db.VarChar(150)
  isPrimary                              Boolean  @default(false) @map("is_primary")
  sortOrder                              Int      @default(0) @map("sort_order")
  createdAt                              DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at                             DateTime @default(now()) @db.Timestamp(0)
  is_active                              Boolean  @default(true)
  created_by                             BigInt?  @db.UnsignedBigInt
  updated_by                             BigInt?  @db.UnsignedBigInt
  product                                Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pimg_product")
  users_product_images_created_byTousers User?    @relation("product_images_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_product_images_created_by")
  users_product_images_updated_byTousers User?    @relation("product_images_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_product_images_updated_by")

  @@index([productId], map: "fk_pimg_product")
  @@index([created_by], map: "fk_product_images_created_by")
  @@index([updated_by], map: "fk_product_images_updated_by")
  @@map("product_images")
}

model ProductAttribute {
  id                                         BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                       String?                     @default("UUID()") @db.VarChar(255)
  name                                       String                      @db.VarChar(100)
  slug                                       String                      @unique(map: "slug") @db.VarChar(120)
  type                                       attribute_type_enum         @default(text)
  multiple_selection                         Boolean                     @default(true)
  createdAt                                  DateTime                    @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at                                 DateTime                    @default(now()) @db.Timestamp(0)
  is_active                                  Boolean                     @default(true)
  created_by                                 BigInt?                     @db.UnsignedBigInt
  updated_by                                 BigInt?                     @db.UnsignedBigInt
  values                                     AttributeValue[]
  product_attribute_values                   product_attribute_values[]
  category_attributes                        category_attributes[]
  variant_attribute_values                   variant_attribute_values[]
  product_attribute_configs                  product_attribute_configs[]
  item_attribute_values                      item_attribute_values[]
  users_product_attributes_created_byTousers User?                       @relation("product_attributes_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_product_attributes_created_by")
  users_product_attributes_updated_byTousers User?                       @relation("product_attributes_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_product_attributes_updated_by")

  @@index([created_by], map: "fk_product_attributes_created_by")
  @@index([updated_by], map: "fk_product_attributes_updated_by")
  @@map("product_attributes")
}

enum attribute_type_enum {
  text
  color
}

model AttributeValue {
  id                                       BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                     String?                        @default("UUID()") @db.VarChar(255)
  attributeId                              BigInt                         @map("attribute_id") @db.UnsignedBigInt
  value                                    String                         @db.VarChar(150)
  color_hex                                String?                        @db.VarChar(7)
  image_url                                String?                        @db.VarChar(255)
  price_adjustment                         Decimal                        @default(0.00) @map("price_adjustment") @db.Decimal(10, 2)
  createdAt                                DateTime                       @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at                               DateTime                       @default(now()) @db.Timestamp(0)
  is_active                                Boolean                        @default(true)
  created_by                               BigInt?                        @db.UnsignedBigInt
  updated_by                               BigInt?                        @db.UnsignedBigInt
  users_attribute_values_created_byTousers User?                          @relation("attribute_values_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_attribute_values_created_by")
  users_attribute_values_updated_byTousers User?                          @relation("attribute_values_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_attribute_values_updated_by")
  attribute                                ProductAttribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attrval_attr")
  product_attribute_values                 product_attribute_values[]
  variant_attribute_values                 variant_attribute_values[]
  variant_unit_prices                      VariantUnitPrice[]
  size_charts                              size_charts[]
  item_attribute_values                    item_attribute_values[]
  dependent_on                             attribute_value_dependencies[] @relation("attr_value_dependencies_child")
  required_by                              attribute_value_dependencies[] @relation("attr_value_dependencies_parent")

  @@index([created_by], map: "fk_attribute_values_created_by")
  @@index([updated_by], map: "fk_attribute_values_updated_by")
  @@index([attributeId], map: "fk_attrval_attr")
  @@map("attribute_values")
}

/// Links a ProductAttribute to the categories it applies to (e.g. "Fabric" -> Dresses,
/// "Movement" -> Watches), so the admin product form only prompts for attributes that
/// are relevant to the product's category instead of one fixed field set for everything.
model category_attributes {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  category_id        BigInt           @db.UnsignedBigInt
  attribute_id       BigInt           @db.UnsignedBigInt
  is_required        Boolean          @default(false)
  sort_order         Int              @default(0)
  created_at         DateTime         @default(now()) @db.Timestamp(0)
  updated_at         DateTime         @default(now()) @db.Timestamp(0)
  product_categories ProductCategory  @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_catattr_category")
  product_attributes ProductAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_catattr_attribute")

  @@unique([category_id, attribute_id], map: "uniq_category_attribute")
  @@index([category_id], map: "fk_catattr_category")
  @@index([attribute_id], map: "fk_catattr_attribute")
}

/// Defines WHICH attributes apply to a Product (e.g. T-Shirt -> Color, Size), so Item
/// creation under this Product only offers value-selection for these attributes instead
/// of a free "add attribute" picker. Distinct from category_attributes, which only
/// suggests candidates - this is the actual per-Product configuration that Items inherit.
model product_attribute_configs {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  product_id         BigInt           @db.UnsignedBigInt
  attribute_id       BigInt           @db.UnsignedBigInt
  is_required        Boolean          @default(false)
  sort_order         Int              @default(0)
  created_at         DateTime         @default(now()) @db.Timestamp(0)
  updated_at         DateTime         @default(now()) @db.Timestamp(0)
  products           Product          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pac_product")
  product_attributes ProductAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pac_attribute")

  @@unique([product_id, attribute_id], map: "uniq_product_attribute_config")
  @@index([product_id], map: "fk_pac_product")
  @@index([attribute_id], map: "fk_pac_attribute")
}

/// Selects WHICH VALUES of the Product's configured attributes apply to a specific Item
/// (e.g. V Neck T-Shirt -> Color: Black, White; Size: S, M, L). This is the value pool
/// that variant generation fans out into ProductVariant (color) x VariantUnitPrice (size)
/// combinations - unlike variant_attribute_values, multiple values per attribute are
/// allowed here (that's the whole point: the admin is picking a pool, not one final pick).
model item_attribute_values {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  item_id            BigInt           @db.UnsignedBigInt
  attribute_id       BigInt           @db.UnsignedBigInt
  attribute_value_id BigInt           @db.UnsignedBigInt
  created_at         DateTime         @default(now()) @db.Timestamp(0)
  updated_at         DateTime         @default(now()) @db.Timestamp(0)
  items              Item             @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_iav_item")
  product_attributes ProductAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_iav_attribute")
  attribute_values   AttributeValue   @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_iav_value")

  @@unique([item_id, attribute_value_id], map: "uniq_item_attribute_value")
  @@index([item_id], map: "fk_iav_item")
  @@index([attribute_id], map: "fk_iav_attribute")
  @@index([attribute_value_id], map: "fk_iav_value")
}

/// Pins a ProductVariant to the exact attribute value it represents (e.g. Color=Red,
/// Size=M), so selecting a combination of attribute values on the product page can
/// resolve to the one matching variant instead of leaving the mapping implicit.
model variant_attribute_values {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  variant_id         BigInt           @db.UnsignedBigInt
  attribute_id       BigInt           @db.UnsignedBigInt
  attribute_value_id BigInt           @db.UnsignedBigInt
  created_at         DateTime         @default(now()) @db.Timestamp(0)
  updated_at         DateTime         @default(now()) @db.Timestamp(0)
  product_variants   ProductVariant   @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vav_variant")
  product_attributes ProductAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vav_attribute")
  attribute_values   AttributeValue   @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vav_value")

  @@unique([variant_id, attribute_id], map: "uniq_variant_attribute")
  @@index([attribute_id], map: "fk_vav_attribute")
  @@index([attribute_value_id], map: "fk_vav_value")
}

/// Restricts a "child" attribute value (e.g. Size=S) to only be a valid pick when a
/// specific "parent" value of another attribute (e.g. Color=Red) is also on the same
/// variant - e.g. a Watch's Silver color only pairs with a Metal strap, not Leather.
/// A value with no rows here is unrestricted and pairs with every value of every other
/// attribute - the default, fully-independent case (plain Color x Size with no rules).
model attribute_value_dependencies {
  id                  BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  attribute_value_id  BigInt         @db.UnsignedBigInt
  depends_on_value_id BigInt         @db.UnsignedBigInt
  created_at          DateTime       @default(now()) @db.Timestamp(0)
  attribute_value     AttributeValue @relation("attr_value_dependencies_child", fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_avd_child")
  depends_on_value    AttributeValue @relation("attr_value_dependencies_parent", fields: [depends_on_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_avd_parent")

  @@unique([attribute_value_id, depends_on_value_id], map: "uniq_attr_value_dependency")
  @@index([attribute_value_id], map: "fk_avd_child")
  @@index([depends_on_value_id], map: "fk_avd_parent")
}

/// Curates which attribute_values (under the "Size" product_attributes entry)
/// are valid for a given category + gender, e.g. Men's T-Shirts -> S/M/L/XL/XXL,
/// Kids' T-Shirts -> 2-3Y/4-5Y/6-7Y. The size values themselves are not
/// duplicated here - they live once in attribute_values, the same row a
/// variant's variant_attribute_values entry points at.
model size_charts {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  category_id        BigInt          @db.UnsignedBigInt
  gender             products_gender
  attribute_value_id BigInt          @db.UnsignedBigInt
  sort_order         Int             @default(0)
  is_active          Boolean         @default(true)
  created_at         DateTime        @default(now()) @db.Timestamp(0)
  updated_at         DateTime        @default(now()) @db.Timestamp(0)
  product_categories ProductCategory @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sizechart_category")
  attribute_values   AttributeValue  @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sizechart_attribute_value")

  @@unique([category_id, gender, attribute_value_id], map: "uniq_sizechart_cat_gender_value")
  @@index([category_id, gender], map: "idx_sizechart_cat_gender")
  @@index([attribute_value_id], map: "idx_sizechart_attr_value")
}

model Cart {
