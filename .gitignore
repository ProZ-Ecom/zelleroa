# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# persistent uploaded files (served via /document, outside the public folder so
# redeploys / git clean never wipe them)
/document

# whatsapp session credentials
/auth_baileys

# local DB backups taken before running one-off migration scripts
/scratch_backup

# AI folder

/.kilo
.agents/
.claude/
.kiro/
*.md
/.agents
/.claude
/.kiro